# Reproducible project requirements; additional options live in main/Kconfig.projbuild.
CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHSIZE_2MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP=y

# LVGL configuration comes from Kconfig, never a competing lv_conf.h.
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_COLOR_16_SWAP=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_MEM_SIZE_KILOBYTES=96
CONFIG_LV_USE_SNAPSHOT=y

# Runtime CPU measurement and fail-safe watchdog.
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y
CONFIG_ESP_TASK_WDT_PANIC=y

# Battery ADC divider / calibration. Charging needs a physically wired pin.
CONFIG_IDROID_BAT_DIVIDER_MILLI=2000
CONFIG_IDROID_BAT_GAIN_PPM=1000000
CONFIG_IDROID_BAT_OFFSET_MV=0
CONFIG_IDROID_BAT_CHARGE_GPIO=-1
CONFIG_IDROID_BAT_CHARGE_ACTIVE_LEVEL=0
# CONFIG_IDROID_SCREENSHOT is not set
# CONFIG_IDROID_LCD_DOUBLE_BUFFER is not set
